{
  "expo": {
    "name": "InternTrack",
    "slug": "interntrack",
    "version": "1.0.0",
    "scheme": "interntrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interntrack.app"
    },
    "android": {
      "package": "com.interntrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3C2274",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InternTrack uses your photo library only when you choose a profile picture, so you can see your own face instead of your initials.",
          "cameraPermission": "InternTrack uses the camera only when you choose to take a new profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d66dcd14-d6bf-483d-ae8b-059ab60f02fb"
      }
    },
    "owner": "jeymzzz"
  }
}
